# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Port the server listens on (defaults to 3000 if omitted)
PORT=3000

# Secret used to sign login tokens. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# PostgreSQL connection string.
# Local example:
#   postgres://user:password@localhost:5432/linkcraft
# Hosted example (Neon gives you one that ends with ?sslmode=require):
#   postgres://user:password@your-host.neon.tech/linkcraft?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/linkcraft

# Set to "production" when deployed (enables trust proxy).
# Leave unset or use "development" locally.
# NODE_ENV=production
